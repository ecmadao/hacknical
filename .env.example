# Local development: copy to .env; npm run start-local loads it automatically.
# Production: use HTTPS and keep APP_KEY stable across deployments.
APP_URL=http://localhost:4000
APP_KEY=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:4000/api/user/login/github/callback
# Pre-seeded invite codes separated by commas/spaces (e.g. HACKNICAL-2026,CODE1,CODE2)
INVITE_CODES=
# Maximum registrations allowed per invite code
INVITE_CODE_MAX_USES=1
